# ─────────────────────────────────────────────────────────────────────────
# SkilledProz Backend — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
API_URL=http://localhost:5000/api
CLIENT_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin
CALL_BASE_URL=http://localhost:5000

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:port/dbname

# ── JWT / auth ───────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ── Paystack ─────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_HIRER_PRO_PLAN_CODE=
PAYSTACK_HIRER_PRO_YEARLY_PLAN_CODE=
PAYSTACK_HIRER_ENT_PLAN_CODE=
PAYSTACK_HIRER_ENT_YEARLY_PLAN_CODE=
PAYSTACK_WORKER_PRO_PLAN_CODE=
PAYSTACK_WORKER_PRO_YEARLY_PLAN_CODE=
PAYSTACK_WORKER_ENT_PLAN_CODE=
PAYSTACK_WORKER_ENT_YEARLY_PLAN_CODE=

# ── Flutterwave ──────────────────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_ENCRYPTION_KEY=
FLW_WEBHOOK_HASH=

# ── Stripe ───────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ── Cloudinary ───────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ────────────────────────────────────────────────────────────────
EMAIL_FROM="SkilledProz <noreply@skilledproz.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=support@skilledproz.com
ADMIN_EMAILS=admin@skilledproz.com

# ── Crypto wallets (payment instructions) ────────────────────────────────
CRYPTO_WALLET_BTC=
CRYPTO_WALLET_ETH=
CRYPTO_WALLET_USDC=
CRYPTO_WALLET_USDT=

# ── Platform bank (manual bank transfers) ────────────────────────────────
PLATFORM_BANK_NAME=
PLATFORM_ACCOUNT_NUMBER=
PLATFORM_ACCOUNT_NAME=

# ── Fee rates ────────────────────────────────────────────────────────────
NGN_HIRER_FEE_RATE=0.05
FOREIGN_HIRER_FEE_RATE=0.10

# ── Cron jobs ────────────────────────────────────────────────────────────
CRON_TIMEZONE=Africa/Lagos
CRON_RETAINED_SCHEDULE=0 9 * * *
CRON_RETAINED_RECONCILE=0 3 * * *
DEBT_CRON_ENABLED=true
DEBT_AUTO_FORGIVE_DAYS=90

# ── AI ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Branding ─────────────────────────────────────────────────────────────
LOGO_URL=https://skilledproz.com/logo.png
FACEBOOK_URL=https://facebook.com/skilledproz
INSTAGRAM_URL=https://instagram.com/skilledproz
TIKTOK_URL=https://tiktok.com/@skilledproz

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DB_QUERIES=false